# ==============================================
# Depo Stok Takip Sistemi - Ortam Degiskenleri Sablonu
# ==============================================
# Bu dosyayi ".env" olarak kopyalayin ve gercek degerleri doldurun:
#   copy .env.example .env
# .env dosyasi .gitignore icinde tanimlidir, ASLA commit etmeyin!

# --- E-posta saglayici: simulasyon | gmail_api | smtp ---
# simulasyon : hicbir mail gonderilmez, sadece konsola yazilir (varsayilan/guvenli)
# gmail_api  : Gmail API + OAuth 2.0 (token.json gerekir, sifre gerektirmez)
# smtp       : Gmail uygulama sifresi ile klasik SMTP
EMAIL_PROVIDER=simulasyon

# --- Gmail API (OAuth 2.0) ayarlari ---
# Google Cloud Console'dan indirdiginiz OAuth istemci JSON'u (proje kokune koyun)
GMAIL_CREDENTIALS_FILE=credentials.json
# Ilk yetkilendirmede otomatik olusur: python -m backend.authorize_gmail
GMAIL_TOKEN_FILE=token.json
# Proje icin olusturdugunuz yeni Gmail adresi (gosterim amaciyla)
GMAIL_SENDER_EMAIL=

# --- E-posta alicilari ---
# Kritik stok onay isteglerinin gittigi gorevli/adres
WORKER_EMAIL=admin@sirket.com
# Urun icin toptanci e-postasi tanimli degilse kullanilan varsayilan toptanci
WHOLESALER_EMAIL=toptanci@sirket.com

# --- Klasik SMTP alternatifi (EMAIL_PROVIDER=smtp ise) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# --- Veritabani (bos birakilirsa sqlite:///./stock.db) ---
DATABASE_URL=
